[project]
name = "{{ python_package }}"
version = "0.1.0"
description = "{{ purpose }}"
requires-python = ">=3.11"
dependencies = [
{% if has_api and has_python %}
  "fastapi>=0.115",
  "uvicorn>=0.30",
{% endif %}
]

[project.optional-dependencies]
dev = [
  "pytest>=8.0",
  "ruff>=0.6",
{% if has_api and has_python %}
  "httpx>=0.27",
{% endif %}
]

[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["src"]

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "I"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]
