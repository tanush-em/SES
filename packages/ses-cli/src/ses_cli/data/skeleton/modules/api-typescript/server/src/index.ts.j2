import http from "node:http";

export function createServer(port = 3000): http.Server {
  return http.createServer((req, res) => {
    if (req.url === "/health") {
      res.writeHead(200, { "content-type": "application/json" });
      res.end(JSON.stringify({ status: "ok", product: "{{ name }}" }));
      return;
    }
    res.writeHead(404);
    res.end();
  }).listen(port);
}

export function healthPayload(): { status: string; product: string } {
  return { status: "ok", product: "{{ name }}" };
}

